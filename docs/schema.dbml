// Pokémon Dictionary — database schema

Table AspNetUsers {
  Id nvarchar(450) [pk]
  UserName nvarchar(256)
}

Table RefreshTokens {
  Id int [pk, increment]
  TokenHash nvarchar(64) [not null, unique]
  AppUserId nvarchar(450) [not null]
  CreatedAt datetime2 [not null]
  ExpiresAt datetime2 [not null]
  RevokedAt datetime2
}

Table GroupTeams {
  GroupId int [not null]
  TeamId int [not null]

  indexes {
    (GroupId, TeamId) [pk]
  }
}

Table Groups {
  Id int [pk, increment]
  Name nvarchar(256) [not null]
  AppUserId nvarchar(450) [not null]

  indexes {
    (AppUserId, Name) [unique]
  }
}

Table Teams {
  Id int [pk, increment]
  Name nvarchar(256) [not null]
  AppUserId nvarchar(450) [not null]

  indexes {
    (AppUserId, Name) [unique]
  }
}

Table Members {
  Id int [pk, increment]
  PokemonId int [not null]
  Slot int [not null, check: `Slot BETWEEN 1 AND 6`]
  TeamId int [not null]

  indexes {
    (TeamId, Slot) [unique]
  }
}


Ref: RefreshTokens.AppUserId > AspNetUsers.Id [delete: cascade]
Ref: Groups.AppUserId > AspNetUsers.Id [delete: no action]
Ref: Teams.AppUserId > AspNetUsers.Id [delete: cascade]
Ref: Members.TeamId > Teams.Id [delete: cascade]
Ref: GroupTeams.GroupId > Groups.Id [delete: cascade]
Ref: GroupTeams.TeamId > Teams.Id [delete: cascade]
